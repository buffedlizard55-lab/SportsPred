{
  "name": "sportspred",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-sport scoreboard, OLBG market directory and source-linked prediction engine (static site, no build step)",
  "type": "module",
  "scripts": {
    "test": "node scripts/ci_node_tests.mjs",
    "build:data": "python3 scripts/build_data.py",
    "collect": "python3 scripts/collect_olbg.py",
    "collect:cricket": "python3 scripts/collect_cricket_olbg.py",
    "record:cricket": "node scripts/record_cricket_predictions.mjs",
    "backtest": "node scripts/backtest.mjs",
    "backtest:historical": "node scripts/backtest_historical.mjs",
    "verify": "node scripts/verify_site.mjs",
    "verify:all": "node scripts/ci_node_tests.mjs && python3 -m unittest discover -s tests -p 'test_*.py' && node scripts/build_t20_blast.mjs --check && node scripts/backtest_t20_blast.mjs --check && node scripts/verify_site.mjs && python3 scripts/build_data.py --strict",
    "build:registry": "node scripts/build_league_registry.mjs",
    "build:context": "node scripts/build_league_context.mjs",
    "backtest:universal": "node scripts/backtest_universal.mjs",
    "collect:greyhounds": "node scripts/collect_greyhound.mjs",
    "backtest:greyhounds": "node scripts/backtest_greyhound.mjs",
    "collect:volleyball": "python3 scripts/collect_volleyball_olbg.py && node scripts/collect_volleyball_espn.mjs",
    "backtest:volleyball": "node scripts/backtest_volleyball.mjs",
    "record:volleyball": "node scripts/record_volleyball_predictions.mjs",
    "collect:snooker": "python3 scripts/collect_snooker_olbg.py --enrich",
    "record:snooker": "node scripts/record_snooker_predictions.mjs",
    "backtest:snooker": "node scripts/backtest_snooker.mjs",
    "collect:darts": "python3 scripts/collect_darts_olbg.py --enrich",
    "record:darts": "node scripts/record_darts_predictions.mjs",
    "backtest:darts": "node scripts/backtest_darts.mjs",
    "collect:gaa": "python3 scripts/collect_gaa_olbg.py",
    "record:gaa": "node scripts/record_gaa_predictions.mjs",
    "backtest:gaa": "node scripts/backtest_gaa.mjs",
    "collect:baseball": "node scripts/collect_baseball_mlb.mjs && python3 scripts/collect_baseball_olbg.py --enrich",
    "record:baseball": "node scripts/record_baseball_predictions.mjs",
    "backtest:baseball": "node scripts/backtest_baseball.mjs",
    "serve": "python3 scripts/serve.py 8000",
    "build:t20-blast": "node scripts/build_t20_blast.mjs",
    "check:t20-blast": "node scripts/build_t20_blast.mjs --check",
    "collect:t20-blast": "node scripts/collect_t20_blast.mjs",
    "backtest:t20-blast": "node scripts/backtest_t20_blast.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
